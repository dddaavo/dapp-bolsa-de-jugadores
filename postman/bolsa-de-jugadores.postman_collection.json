{
  "info": {
    "name": "Bolsa de Jugadores",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT de usuario normal (USER). Se llena automáticamente al hacer login."
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string",
      "description": "JWT de admin. Se llena automáticamente al hacer Admin Login."
    },
    {
      "key": "userId",
      "value": "",
      "type": "string",
      "description": "ID del usuario logueado. Se llena automáticamente al hacer login."
    }
  ],
  "item": [
    {
      "name": "Health & Observabilidad",
      "item": [
        {
          "name": "GET /actuator/health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health"
          }
        },
        {
          "name": "GET /actuator/metrics (ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/actuator/metrics"
          }
        },
        {
          "name": "GET /actuator/prometheus (público)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/prometheus"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@test.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login  ← guarda token y userId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('token', json.accessToken);",
                  "  console.log('Token de usuario guardado.');",
                  "}",
                  "if (json.userId) {",
                  "  pm.collectionVariables.set('userId', json.userId);",
                  "  console.log('userId guardado: ' + json.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@test.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login (ADMIN)  ← guarda adminToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('adminToken', json.accessToken);",
                  "  console.log('Token de admin guardado.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"system@bolsa.local\",\n  \"password\": \"admin1234\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login (alice@example.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('token', json.accessToken);",
                  "}",
                  "if (json.userId) {",
                  "  pm.collectionVariables.set('userId', json.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Alice1234\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/register (email duplicado → 422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Alice1234\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login (password incorrecto → 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        }
      ]
    },
