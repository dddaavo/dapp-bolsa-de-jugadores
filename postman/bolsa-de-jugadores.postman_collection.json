{
  "info": {
    "name": "Bolsa de Jugadores",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /actuator/health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@test.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login  ← guarda token y userId automáticamente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('token', json.accessToken);",
                  "  console.log('Token guardado en variable {{token}}');",
                  "}",
                  "if (json.userId) {",
                  "  pm.collectionVariables.set('userId', json.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@test.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/register (email duplicado → 422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@test.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login (password incorrecto → 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@test.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Jugadores",
      "item": [
        {
          "name": "GET /api/v1/players (sin token → 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/players"
          }
        },
        {
          "name": "GET /api/v1/players — todos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/players?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "players"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET /api/v1/players — filtro por liga (LA_LIGA)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/players?league=LA_LIGA&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "players"],
              "query": [
                { "key": "league", "value": "LA_LIGA" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET /api/v1/players — filtro por posición (FW)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/players?position=FW&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "players"],
              "query": [
                { "key": "position", "value": "FW" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET /api/v1/players — filtro por equipo",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/players?team=madrid&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "players"],
              "query": [
                { "key": "team", "value": "madrid" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET /api/v1/players/{id} — existente → 200",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/players/1"
          }
        },
        {
          "name": "GET /api/v1/players/{id} — inexistente → 404",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/players/9999"
          }
        }
      ]
    },
    {
      "name": "Cotización",
      "item": [
        {
          "name": "GET /api/v1/players/{id}/quotes/current — cotización vigente",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/players/1/quotes/current"
          }
        },
        {
          "name": "GET /api/v1/players/{id}/quotes — historial completo",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/players/1/quotes"
          }
        },
        {
          "name": "GET /api/v1/players/{id}/quotes — filtro por rango de fechas",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/players/1/quotes?from=2026-01-01&to=2026-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "players", "1", "quotes"],
              "query": [
                { "key": "from", "value": "2026-01-01" },
                { "key": "to", "value": "2026-12-31" }
              ]
            }
          }
        },
        {
          "name": "GET /api/v1/players/ranking — top 10 por cotización",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/players/ranking?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "players", "ranking"],
              "query": [
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET /api/v1/players/ranking — filtro por estrategia",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/players/ranking?strategy=PositionWeighted&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "players", "ranking"],
              "query": [
                { "key": "strategy", "value": "PositionWeighted" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "POST /api/v1/quotes/recalculate — recalcular (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/quotes/recalculate"
          }
        }
      ]
    },
    {
      "name": "Mercado",
      "item": [
        {
          "name": "POST /api/v1/orders/buy — comprar tokens",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": "{{baseUrl}}/api/v1/orders/buy",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": 1,\n  \"quantity\": 5\n}"
            }
          }
        },
        {
          "name": "POST /api/v1/orders/buy — sin Idempotency-Key → 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/orders/buy",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": 1,\n  \"quantity\": 5\n}"
            }
          }
        },
        {
          "name": "POST /api/v1/orders/buy — stock insuficiente → 422",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": "{{baseUrl}}/api/v1/orders/buy",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": 1,\n  \"quantity\": 9999\n}"
            }
          }
        },
        {
          "name": "POST /api/v1/orders/sell — vender tokens",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": "{{baseUrl}}/api/v1/orders/sell",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": 1,\n  \"quantity\": 2\n}"
            }
          }
        },
        {
          "name": "POST /api/v1/orders/sell — sin holding → 422",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": "{{baseUrl}}/api/v1/orders/sell",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": 9999,\n  \"quantity\": 1\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "GET /api/v1/users/{id}/transactions — historial propio",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/transactions?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "transactions"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "GET /api/v1/users/{id}/transactions — filtro por tipo BUY",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/transactions?type=BUY",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "transactions"],
              "query": [
                { "key": "type", "value": "BUY" }
              ]
            }
          }
        },
        {
          "name": "GET /api/v1/users/{id}/transactions — filtro por fecha",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/transactions?from=2026-01-01&to=2026-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "transactions"],
              "query": [
                { "key": "from", "value": "2026-01-01" },
                { "key": "to", "value": "2026-12-31" }
              ]
            }
          }
        },
        {
          "name": "GET /api/v1/users/{id}/transactions — otro usuario → 403",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/users/9999/transactions"
          }
        }
      ]
    }
  ]
}
